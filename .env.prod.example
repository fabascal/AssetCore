# AssetCore — production environment
# Copy to .env.prod in repo root, then: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public URL (no trailing slash)
DOMAIN=189.206.183.110
NGINX_HTTP_PORT=4040

# Postgres (internal Docker network — host NOT exposed)
POSTGRES_DB=assetcore
POSTGRES_USER=assetcore
POSTGRES_PASSWORD=

# Backend — host must be "postgres" (service name), not 127.0.0.1
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://assetcore:CHANGE_ME@postgres:5432/assetcore

JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN_SEC=900
REFRESH_TOKEN_DAYS=7

# HTTP pre-TLS staging
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGIN=http://189.206.183.110:4040,http://192.168.200.31:5173

# HTTPS go-live (replace block above)
# COOKIE_SECURE=true
# COOKIE_DOMAIN=assetcore.example.com
# CORS_ORIGIN=https://assetcore.example.com

WEBHOOK_SECRET=

# Frontend build (same-origin API via nginx)
VITE_API_URL=/api

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PROVIDER_WHATSAPP_TO=

# One-time admin (run create-admin.ts after first deploy)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrador
