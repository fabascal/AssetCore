# AssetCore — Production backend environment
# Copy to .env on the server (never commit real values)

NODE_ENV=production
PORT=4000

# Database (use strong password; host = docker service name in compose)
DATABASE_URL=postgresql://assetcore:CHANGE_ME_STRONG@postgres:5432/assetcore

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN_SEC=900
REFRESH_TOKEN_DAYS=7

# Cookies & CORS (must match public HTTPS URL)
COOKIE_SECURE=true
COOKIE_DOMAIN=assetcore.example.com
CORS_ORIGIN=https://assetcore.example.com

# Webhook protection (header X-Webhook-Secret)
WEBHOOK_SECRET=

# Optional integrations
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PROVIDER_NOTIFY_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PROVIDER_WHATSAPP_TO=
